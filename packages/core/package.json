{
	"name": "@zlogin/core",
	"version": "0.1.0",
	"private": true,
	"description": "Shared public contracts and capability metadata for ZLogin integrations",
	"type": "module",
	"license": "UNLICENSED",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
